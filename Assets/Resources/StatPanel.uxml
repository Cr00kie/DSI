<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <ui:VisualElement name="Stat" style="flex-grow: 1; height: auto; max-height: 20%; min-height: 20%; justify-content: flex-start; flex-direction: row; padding-top: 30px; padding-right: 30px; padding-bottom: 30px; padding-left: 30px; align-items: center; align-self: center;">
        <ui:Label tabindex="-1" text="Power: " parse-escape-sequences="true" display-tooltip-when-elided="true" name="StatName" style="color: rgb(255, 255, 255); font-size: 40px; -unity-text-align: middle-left; max-width: 150px; min-width: 150px; flex-wrap: wrap; white-space: normal;" />
        <ui:VisualElement name="IconContainer" style="flex-grow: 1; flex-direction: row; align-items: center; align-self: center;" />
    </ui:VisualElement>
</ui:UXML>
